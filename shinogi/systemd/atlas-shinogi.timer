# Atlas shinogi renderer timer, every 6h, matching the fleet cadence and
# the Cloudflare Pages Free build budget (500 a month; six-hourly tops out
# near 124, and an edition whose facts have not moved is not published at
# all).
#
# Offset to :55. The fleet timer starts at 00/6:20 with a 15m randomized
# delay, so the reconcile pass begins between :20 and :35; :55 puts this
# render after it, so mine_econ and metric_activity are the current pass's.
# livedata is refreshed hourly and independently.
#
# LOCAL TIME ON PURPOSE. Do NOT add UTC=true "for consistency" with the
# page's UTC as-of line. atlas-fleet.timer runs on local time, and the
# ordering above only holds while both sit on the same clock. The device is
# Pacific/Auckland, which shifts between +12 and +13: under NZDT a UTC
# schedule would land this render 25 minutes BEFORE the fleet pass instead
# of after it, and the page would report the previous pass's mining and
# activity figures.
#
# A DST transition can skip or repeat one slot. Persistent=true catches up
# a skipped one, and a repeat is harmless because the fact gate makes the
# second pass a no-op.
[Unit]
Description=Atlas shinogi public edition timer

[Timer]
OnCalendar=*-*-* 00/6:55:00
RandomizedDelaySec=3m
Persistent=true

[Install]
WantedBy=timers.target
