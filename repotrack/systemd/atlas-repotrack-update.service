# Atlas subtensor repository update (PRD §21 Q20: hourly, decided 2026-07-12)
# Install (user-level, as pi; linger is on):
#   cp ~/atlas/repotrack/systemd/atlas-repotrack-update.{service,timer} \
#     ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now atlas-repotrack-update.timer
#
# The gate poll and the Telegram scan left this unit (change:
# alert-delivery-reliability). They run on atlas-alerts.timer, so a failed
# repo update no longer silences alerts.
[Unit]
Description=Atlas subtensor repository update
Wants=network-online.target
After=network-online.target

OnFailure=atlas-notify-failure@%n.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/pi/atlas/repotrack/atlas_repo.py update
