# Atlas environment template (PRD §21 Q24, decided 2026-07-12).
#
# Copy to `.env` on the Pi (chmod 600) and fill in. `.env` is gitignored —
# secrets never enter the repo, logs, or chat (ATLAS-API-008).
#
#   cp env.example .env && chmod 600 .env

# TaoStats API key (Phase 4) — from the TaoStats dashboard.
# Base URL https://api.taostats.io, sent as `Authorization: <key>` header.
# Limits: 60/min, 60,000/day.
TAOSTATS_API_KEY=

# TaoSwap (https://api.taoswap.org) is keyless — no variable needed.
# CoinGecko simple/price (TAO/USD cross-check) is keyless — no variable needed.
