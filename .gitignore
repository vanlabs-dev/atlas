# Inventory outputs describe the device in detail (users, ports, versions)
# and must never be committed — the Pi's checkout is the live working tree.
var/
inventory/var/

# Python
__pycache__/
*.pyc

# Local environment / secrets (secrets never belong in this repo at all)
.env
.env.*
*.local

# Per-machine agent state (the shared .claude/commands and skills stay tracked)
.claude/settings.local.json
CLAUDE.local.md

# Python tooling
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local data and logs
*.db
*.db-shm
*.db-wal
*.log

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Node and Vercel (web/)
node_modules/
.next/
.vercel/
web/.env*
*.tsbuildinfo
