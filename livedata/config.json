{
  "_comment": "Live-data provider policy. Values pinned from the operator-approved discovery gates of 2026-07-12 (docs/decisions.md 'Phase 4 discovery gates'): TaoSwap report 20260712T013740Z-f50d283e, TaoStats report 20260712T014512Z-0ee4f8c4. TaoStats free tier: 5/min, 10,000/MONTH; Atlas self-caps at 2/min (headroom by design) and reserves 20% of the month for interactive use. Price checking spends no TaoStats quota (Q30).",
  "providers": {
    "taoswap": {
      "base_url": "https://api.taoswap.org",
      "auth": "none",
      "quota": {
        "per_minute_cap": 20,
        "min_spacing_seconds": 1.0,
        "_rate_note": "no documented/observed limit — politeness policy per ATLAS-LIVE-007"
      }
    },
    "taostats": {
      "base_url": "https://api.taostats.io",
      "auth": "header",
      "auth_header": "Authorization",
      "key_env": "TAOSTATS_API_KEY",
      "timeout_seconds": 45,
      "_timeout_note": "observed spiky latency (>20s) from the Pi during discovery and acceptance",
      "quota": {
        "per_minute_cap": 2,
        "window_kind": "month",
        "window_limit": 10000,
        "interactive_reserve_fraction": 0.8,
        "min_spacing_seconds": 15.0
      }
    },
    "coingecko": {
      "base_url": "https://api.coingecko.com",
      "auth": "none",
      "quota": {
        "per_minute_cap": 5,
        "min_spacing_seconds": 2.0
      }
    }
  },
  "db": "var/livedata/livedata.db",
  "output_dir": "var/livedata",
  "cache_max_rows": 200,
  "request_timeout_seconds": 20,
  "retry": {
    "default_attempts": 2,
    "retry_on_status": [500, 502, 503, 504],
    "never_retry_on_status": [429],
    "jitter_seconds": [0.5, 2.0]
  },
  "price_tolerance_pairwise": 0.05,
  "gate_signal": {
    "_comment": "Emission-gate crossing signal (change: gate-crossing-signal). DEFAULTS OFF: `enabled` false makes poll-gate inert and the Telegram gate-crossing class silent — flipping it is the whole rollback. Reads the spec-440 gate state (theta/q/h) from finney via keyless JSON-RPC state_getStorage on PINNED pre-verified keys (twox128('SubtensorModule') ++ twox128(item); verified against live Finney 2026-07-28), all at one finalized block. Null storage is normal (Substrate never writes ValueQuery defaults): null q/h uses assumed_defaults marked assumed-default provenance (spec-440 code defaults — live q was ALREADY explicit 0.75 on 2026-07-28); null/zero theta records gate-inactive. Demand shares come from the subnets_taoswap panel of the same pass, normalized over ALL non-root subnets (the chain's bar universe includes emission-disabled subnets). hysteresis_pct is the relative band around theta a share must exit on confirm_polls consecutive polls to flip a side; absence_clear_polls clears a vanished netuid's side (netuid-reuse guard). rpc_endpoints are tried in order; verify reachability from the Pi at deploy and record the choice in docs/decisions.md.",
    "enabled": false,
    "rpc_endpoints": ["https://entrypoint-finney.opentensor.ai"],
    "storage_keys": {
      "EmissionGateBar": "0x658faa385070e074c85bf6b568cf05557c9b0d2964cc73e7519676c3cc4d5df9",
      "EmissionBarQuantile": "0x658faa385070e074c85bf6b568cf0555a772007dde2ed63e0f21b5f9d7f16650",
      "EmissionGateExponent": "0x658faa385070e074c85bf6b568cf055588c70e8dd0cf4af3aeb977ba2eee1df4"
    },
    "assumed_defaults": {
      "EmissionBarQuantile": 0.61,
      "EmissionGateExponent": 3.0
    },
    "hysteresis_pct": 10,
    "confirm_polls": 2,
    "absence_clear_polls": 3,
    "rpc_timeout_seconds": 20
  },
  "wallet_aliases": {
    "_comment": "Operator public coldkeys only (no seeds/keys). Aliases resolve for live_portfolio account=.",
    "SECURE": {
      "ss58": "5EcUreZxeehdR5qssdtVPP7yZPemKqhbuEc5gdG9pwcSF69m",
      "role": "primary subnet investments + TAO",
      "ledger": true
    },
    "5FART": {
      "ss58": "5FartJgfyxgxymn72BRDgA4yRo3C43RtLQd6LJqLxjChCdu6",
      "role": "subnet miners (Bitcast + planned)",
      "ledger": true
    },
    "CRUSTY": {
      "ss58": "5Fmw8rgoRBquGBy4q3d27SxPFVJEEHXUHWek8UrwAbqXY3pt",
      "role": "open non-Ledger wallet for agent management",
      "ledger": false
    }
  },
  "operations": {
    "price_spot_coingecko": {
      "provider": "coingecko",
      "path": "/api/v3/simple/price",
      "params": {"ids": "bittensor", "vs_currencies": "usd",
                 "include_last_updated_at": true},
      "schema": "coingecko/simple-price.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 900, "max_local_age_s": 60,
                   "expected_cadence": "spot (minutes)"}
    },
    "price_daily_taoswap": {
      "provider": "taoswap",
      "path": "/price-history/",
      "params": {"currency": "usd"},
      "schema": "taoswap/price-history.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 172800, "max_local_age_s": 60,
                   "expected_cadence": "daily close"}
    },
    "subnets_taoswap": {
      "provider": "taoswap",
      "path": "/v2/subnets/",
      "params": {},
      "client_params": ["netuid"],
      "schema": "taoswap/subnets.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 3600, "max_local_age_s": 60,
                   "expected_cadence": "near-live aggregates"},
      "_note": "Post-processor surfaces emission_miner_burn (0-100 percent), root_proportion, moving_price, excess_tao_*, etc. client_params.netuid is a local filter only."
    },
    "validators_taoswap": {
      "provider": "taoswap",
      "path": "/v2/validators/",
      "params": {},
      "schema": "taoswap/validators.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 3600, "max_local_age_s": 60,
                   "expected_cadence": "near-live"}
    },
    "network_stats_taoswap": {
      "provider": "taoswap",
      "path": "/network-stats/",
      "params": {},
      "schema": "taoswap/network-stats.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 172800, "max_local_age_s": 60,
                   "expected_cadence": "daily snapshot"}
    },
    "metagraph_taoswap": {
      "provider": "taoswap",
      "path": "/metagraph/{netuid}/",
      "params": {},
      "client_params": ["limit"],
      "schema": "taoswap/metagraph.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 3600, "max_local_age_s": 60,
                   "expected_cadence": "per-epoch"},
      "_note": "Keyless full-subnet metagraph. client_params.limit caps pruned neurons (default 25, max 64)."
    },
    "blocks_taoswap": {
      "provider": "taoswap",
      "path": "/blocks/",
      "params": {"page_size": 1},
      "schema": "taoswap/blocks.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 120, "max_local_age_s": 60,
                   "expected_cadence": "~12s block cadence"},
      "_note": "Chain head without runtime spec_version — use chain_head_taostats when spec is needed."
    },
    "portfolio_balance_taoswap": {
      "provider": "taoswap",
      "path": "/portfolio-balance/",
      "params": {},
      "schema": "taoswap/portfolio-balance.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 172800, "max_local_age_s": 60,
                   "expected_cadence": "daily portfolio snapshot"},
      "_note": "Requires dynamic_params.account (ss58 coldkey)."
    },
    "portfolio_pnl_apy_taoswap": {
      "provider": "taoswap",
      "path": "/portfolio-pnl-apy/",
      "params": {},
      "schema": "taoswap/portfolio-pnl-apy.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 172800, "max_local_age_s": 60,
                   "expected_cadence": "daily portfolio snapshot"},
      "_note": "Requires dynamic_params.account (ss58 coldkey)."
    },
    "subnets_taostats": {
      "provider": "taostats",
      "path": "/api/subnet/latest/v1",
      "params": {},
      "schema": "taostats/subnets.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 3600, "max_local_age_s": 60,
                   "expected_cadence": "near-live (latest)"}
    },
    "metagraph_taostats": {
      "provider": "taostats",
      "path": "/api/metagraph/latest/v1",
      "params": {},
      "schema": "taostats/metagraph.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 3600, "max_local_age_s": 60,
                   "expected_cadence": "per-epoch"}
    },
    "chain_head_taostats": {
      "provider": "taostats",
      "path": "/api/block/v1",
      "params": {"limit": 1, "order": "block_number_desc"},
      "schema": "taostats/blocks.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": 120, "max_local_age_s": 60,
                   "expected_cadence": "~12s block cadence"},
      "_note": "order pinned explicitly — the conviction enactment watch (spec_version >= 425)"
    },
    "subnet_identity_taostats": {
      "provider": "taostats",
      "path": "/api/subnet/identity/v1",
      "params": {"limit": 200},
      "schema": "taostats/subnet-identity.v1",
      "envelope": {"must_hit_provider": true,
                   "max_upstream_age_s": null, "max_local_age_s": 60,
                   "expected_cadence": "near-live identity (owner-edited, rarely)"},
      "_note": "netuid -> on-chain SubnetIdentity.github_repo for the subnet-repo-fleet reconciler; paginated (aggregated to completion by run_subnet_identity); the endpoint does not provide the owner ss58"
    }
  }
}
