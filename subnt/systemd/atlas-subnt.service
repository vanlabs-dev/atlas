# Atlas subnt renderer: compose the public edition from the Atlas stores
# and publish it into the subnt checkout on a fact change (change:
# subnt-renderer). Install (operator, needs sudo):
# For an existing publisher, first follow docs/subnt-rename.md in the
# public-page repo: disable the old timer and migrate checkout and state.
#   sudo cp ~/atlas/subnt/systemd/atlas-subnt.{service,timer} \
#     /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now atlas-subnt.timer
#
# Its own unit, not an ExecStartPost on atlas-fleet.service: that unit runs
# the repo reconcile pass, and a bug here writes to a public site. The
# operator must be able to stop publishing without stopping reconciliation.
#
# Preconditions the unit does not create and will not work around: a
# subnt checkout at the configured checkout_dir, and a write credential
# for that remote. Without either, the pass fails closed and writes
# nothing. Publishing is enabled in subnt/config.json; complete migration
# and verify the credential before starting this service.
[Unit]
Description=Atlas subnt public edition
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/atlas
ExecStart=/usr/bin/python3 /home/pi/atlas/subnt/atlas_subnt.py publish
Nice=10
IOSchedulingClass=idle
