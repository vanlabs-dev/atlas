# Atlas runtime upgrade job (change: runtime-upgrade-pipeline). Runs from
# the live tree; the model edits only in the ~/atlas-upgrade worktree. Every
# step has its own timeout inside the job, so it records its own failures.
# TimeoutStartSec is a backstop only: a run it kills is found by the next
# run and reported once as stalled. (The design named RuntimeMaxSec, but
# systemd ignores RuntimeMaxSec for Type=oneshot, whose whole run is the
# start phase.) Telegram credentials come from
# ~/.hermes/.env through the telegram module, so no EnvironmentFile.
# Install (user-level, as pi):
#   cp ~/atlas/upgrade/systemd/atlas-upgrade.{service,timer} \
#     ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now atlas-upgrade.timer
[Unit]
Description=Atlas runtime upgrade job (user-level; no root)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pi/atlas
Environment=ATLAS_CLAUDE_BIN=/home/pi/.local/bin/claude
ExecStart=/usr/bin/python3 /home/pi/atlas/upgrade/atlas_upgrade.py run
TimeoutStartSec=45min
